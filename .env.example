# Configuration for the Job–Candidate Matching Platform (HLD §16.3).
# Copy this file to .env and adjust it. Never commit .env.
#
# docker compose reads .env. The backend also reads it when it runs from the virtual
# environment. Inside Docker, docker-compose.yml overrides DATABASE_URL, REDIS_URL and
# UPLOAD_DIR with container values (host names "db" and "redis").

# --- Database (PostgreSQL) ---------------------------------------------------
POSTGRES_USER=app
# Local development only. Use letters and digits, or URL-encode the password in DATABASE_URL.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=matching
# Used when the API or worker runs on this machine. It must repeat the three values above.
# Port 5433 is where docker-compose.dev.yml publishes the database container.
# 127.0.0.1 rather than localhost: on Windows, psycopg can stall trying IPv6 (::1) first.
DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:5433/matching

# --- Message broker (Redis, used by Celery) ----------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# --- Frontend <-> API --------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Read by Vite at build time.
VITE_API_BASE_URL=http://localhost:8000
VITE_POLL_INTERVAL_MS=2000
# Interactive API documentation at /docs, /redoc and /openapi.json. Keep true for local
# development; docker-compose.prod.yml sets both to false (the frontend then hides its docs links).
API_DOCS_ENABLED=true
VITE_API_DOCS_ENABLED=true

# --- Resume uploads ----------------------------------------------------------
UPLOAD_DIR=./uploads
# Per file. Larger files are rejected one by one (FILE_TOO_LARGE); the others are still accepted.
MAX_UPLOAD_MB=20
# Files per upload request. More files make the whole request fail with 422.
MAX_UPLOAD_FILES=20
# All files of one upload request together, counted while the request streams in. A larger
# request is stopped at once with 422, before it is stored. Must be larger than MAX_UPLOAD_MB.
MAX_UPLOAD_REQUEST_MB=50
# PDFs with more pages fail in the worker (limits the damage of "PDF bomb" files).
PDF_MAX_PAGES=20

# --- Crawler -----------------------------------------------------------------
CRAWLER_USER_AGENT=FITSCAN-JobMatcher/0.1
# Minimum seconds between two requests to the same host (robots.txt Crawl-delay can raise it).
CRAWLER_DEFAULT_DELAY_SECONDS=1.0
# Retries after the first attempt, for timeouts, HTTP 429 and 5xx (so 3 means up to 4 attempts).
CRAWLER_MAX_RETRIES=3
CRAWLER_MAX_PAGES_LIMIT=500
# Timeout for one HTTP request, and for one headless-browser render.
CRAWLER_REQUEST_TIMEOUT_SECONDS=15
# Comma-separated private hosts the crawler may reach despite the SSRF guard.
# mock-site is the Docker-internal demo site; remove it to block every private address.
CRAWLER_PRIVATE_HOST_ALLOWLIST=mock-site

# --- OCR of scanned resumes (Tesseract, installed in the worker image only) ---
OCR_ENABLED=true
# Tesseract language code(s), e.g. eng or eng+deu. Other languages need their Tesseract data package.
OCR_LANGUAGE=eng
# A page with fewer extractable characters than this, and at least one image, counts as scanned.
OCR_MIN_TEXT_CHARS=25
# Time limit for reading one page.
OCR_TIMEOUT_SECONDS=60

# --- Matching (required, nice-to-have, experience, location; must add up to 100)
MATCH_WEIGHTS=70,15,10,5
# After a crawl (completed, or failed after saving jobs) that saved new jobs or changed a job's
# skills, minimum experience, location, remote flag or description, queue a match run with the
# active weights. Never after a cancelled crawl. false: recompute by hand.
AUTO_REMATCH=true

# --- Stale background-job detection (seconds) -------------------------------
JOB_HEARTBEAT_TIMEOUT_SECONDS=600
JOB_QUEUED_TIMEOUT_SECONDS=600
