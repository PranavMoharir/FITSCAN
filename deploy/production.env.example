# FITSCAN production settings, for the SERVER only (deploy/README.md).
# On the server:  cp deploy/production.env.example .env   then replace every <...> value, and check
# the result with:  bash deploy/check-env.sh   (it refuses placeholders and unsafe values).
# Never copy this file back into the repository with real values, and never reuse your local .env.

# --- Public address and access ---------------------------------------------------------------
# Host name only (no https://, no path), e.g. fitscan-demo.duckdns.org
FITSCAN_DOMAIN=<your-name>.duckdns.org
# Login for the browser's password prompt (HTTP Basic authentication over HTTPS)
BASIC_AUTH_USER=<login-name>
# bcrypt hash of a long random password, made with:
#   docker run --rm -it caddy:2.11.9-alpine caddy hash-password
# Keep the single quotes: the hash contains $ signs.
BASIC_AUTH_HASH='<bcrypt-hash>'

# --- PostgreSQL (a new, empty database on the server; it never holds a copy of local data) ------
POSTGRES_USER=fitscan
# A long random password, made with: openssl rand -hex 24
# (letters and digits only: docker-compose.yml puts it into the database URL without encoding it)
POSTGRES_PASSWORD=<long-random-password>
POSTGRES_DB=matching
# DATABASE_URL and REDIS_URL are not needed here: docker-compose.yml builds both for the containers
# from the three values above and the service names `db` and `redis`.

# --- Behaviour -------------------------------------------------------------------------------
# Production starts match runs by hand (Recompute matches). Do not change this to true: true would
# queue a match run automatically after every crawl that saved new or changed jobs.
AUTO_REMATCH=false
# Uncomment only together with `--profile demo` (the mock job site); otherwise leave it out.
# CRAWLER_PRIVATE_HOST_ALLOWLIST=mock-site

# Every other setting keeps the default documented in .env.example. docker-compose.prod.yml sets
# API_DOCS_ENABLED=false, VITE_API_DOCS_ENABLED=false, CORS_ORIGINS and VITE_API_BASE_URL itself.
