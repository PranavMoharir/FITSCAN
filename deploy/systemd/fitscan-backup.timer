# Starts fitscan-backup.service every day at 03:00 server time (UTC on the Oracle image, 08:30 in India).
# Persistent=true runs a backup that was missed because the server was off as soon as it is back.
[Unit]
Description=Daily FITSCAN database backup

[Timer]
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
